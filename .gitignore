# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# verification screenshots + local caches (not part of the project)
/shot-*.png
/download/
/scripts/csgo-snd/
/scripts/sfx/wav/
tool-results/
# raw user uploads + local-only artifacts (never push — repo carries only running assets)
/upload/
/tehran_game.json
.zscripts/*.pid
public/assets/maps/*/debug-top.*

# player/model binaries stay OUT of git until the user explicitly accepts them
# (big binaries bloat history; a fresh clone falls back to the procedural rig
#  and just drops the accepted model files into public/assets/models/)
public/assets/models/*
!public/assets/models/README.md
# ASSET-ACCEPTANCE POLICY (user rule): any NEW binary asset — sounds, textures,
# models, geometry — stays out of git until the user explicitly OKs it.
# Already-tracked files are unaffected (gitignore only holds back NEW files).
public/assets/sounds/*
public/assets/textures/*
!public/assets/textures/weapons/README.md
public/assets/geom/*
public/assets/maps/*/*
!public/assets/maps/*/geom.json
# raw asset staging + platform/local junk
/assets/
tmp/
.initial_snapshot.json
